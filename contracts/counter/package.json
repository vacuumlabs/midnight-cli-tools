{
  "name": "@cap/counter-contract",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./compiled": {
      "types": "./dist/compiled/contract/index.d.ts",
      "require": "./dist/compiled/contract/index.cjs",
      "import": "./dist/compiled/contract/index.cjs",
      "default": "./dist/compiled/contract/index.cjs"
    }
  },
  "scripts": {
    "compact": "compact compile src/counter.compact src/compiled",
    "build": "npm run compact & cp -r src/compiled dist/compiled"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
