/// Bunch of defined constant to reduce amount of inlined constants in the actual smart contracts.
pragma language_version >= 0.18.0 && < 0.19.0;

module MathConstants {
  export circuit Uint8_MAX(): Uint<8> {
    return 0xFF;
  }

  export circuit Uint16_MAX(): Uint<16> {
    return 0xFFFF;
  }

  export circuit Uint32_MAX(): Uint<32> {
    return 0xFFFFFFFF;
  }

  export circuit Uint64_MAX(): Uint<64> {
    return 0xFFFFFFFFFFFFFFFF;
  }

  export circuit Uint128_MAX(): Uint<128> {
    return 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF;
  }
}
